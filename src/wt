    wt_path = ctx.worktree_path(name)
    ctx.tabs.open(wt_path, workspace=workspace)


def cmd_background(ctx, argv):
    """Relocate the current worktree's branch + uncommitted work into a new
    worktree, leaving the current one on the base branch."""
    open_tab, workspace, name = True, False, ""
    for a in argv:
        if a == "--no-tab":
            open_tab = False
        elif a == "--workspace":
            workspace = True
        elif a == "--surface":
            pass
        elif a.startswith("-"):
            die(f"unknown flag: {a}")
        else:
            if name:
                die("too many arguments")
            name = a

    cwd_path = ctx.current_worktree_path()
    cwd_name = os.path.basename(cwd_path)
    orig_branch = ctx.git.branch_of(cwd_path)

    clean = ctx.git.is_clean(cwd_path)
    if clean and orig_branch == ctx.base_branch:
        die(f"nothing to move: {cwd_name} is clean and on {ctx.base_branch} (use `wt co -b` instead)")

    # Resolve the branch prefix up front — see cmd_checkout.
    prefix = branch_prefix(ctx)

    # Pick a name if none given: the prefix-less branch name (ryanm/wt → wt,
    # cc/foo/bar → foo-bar, spike → spike) via the same folder-naming rule
    # used below. A clean base branch is already rejected above, so any branch
    # we get here yields a usable name; a folder collision still errors below.
    if not name:
        name = folder_for_branch(orig_branch)

    # Destination folder: normalize the name through branch_for (which adds
    # the configured branch prefix unless one is already present) and then
    # feed it through folder_for_branch so the folder-naming rule is applied
    # once, in one place. This works for both the reuse path (orig_branch kept
    # as-is) and the fresh-branch path, since the folder name is independent
    # of the branch's prefix.
    new_folder = folder_for_branch(branch_for(ctx, name, prefix))
    new_wt_path = os.path.join(ctx.new_worktrees_dir, new_folder)
    if ctx.worktree_exists(new_folder):
        die(f"worktree already exists: {ctx.describe_existing(new_folder)} "
            "(pass a different name: `wt bg <name>`)")

    ctx.ensure_worktrees_dir()

    # Stash uncommitted changes (if any) with a recognizable message.
    stashed = False
    if not clean:
        print(f"wt: stashing changes in {cwd_name}...")
        ctx.git.stash_push(cwd_path, f"wt move from {cwd_name} {int(time.time())}")
        stashed = True

    if orig_branch != ctx.base_branch:
        # The new worktree takes the branch and the current worktree moves to
        # the base branch.
        print(f"wt: moving {orig_branch} out of {cwd_name}...")
        # Detach first so the branch is free to be checked out elsewhere.
        ctx.git.checkout_fatal(cwd_path, orig_branch, detach=True)
        if not ctx.git.worktree_add(new_wt_path, orig_branch, fatal=False):
            # Recovery: reattach the branch in the current worktree and
            # restore the stash. Track both so the error message is honest.
            reattach_ok = ctx.git.checkout_ok(cwd_path, orig_branch)
            pop_ok = ctx.git.stash_pop_ok(cwd_path, silent=True) if stashed else True
            if reattach_ok and pop_ok:
                die(f"failed to create new worktree; state restored in {cwd_name}")
            elif reattach_ok:
                die(f"failed to create new worktree; branch reattached in {cwd_name} "
                    "but stash pop failed — see `git stash list`")
            elif pop_ok:
                die(f"failed to create new worktree; reattach of {orig_branch} failed — "
                    f"{cwd_name} is left detached")
            else:
                die(f"failed to create new worktree AND recovery failed: {cwd_name} detached, "
                    "stash still in `git stash list`")
        # Move current onto the base branch. If it's checked out in another
        # worktree, fall back to a detached checkout at the base ref.
        ctx.git.fetch_base(ctx.base_branch, quiet=True)
        if ctx.git.checkout_ok(cwd_path, ctx.base_branch):
            print(f"wt: {cwd_name} now on {ctx.base_branch}")
        else:
            ctx.git.checkout_fatal(cwd_path, ctx.base_ref, detach=True)
            print(f"wt: {cwd_name} now at {ctx.base_ref} (detached; "
                  f"{ctx.base_branch} is checked out elsewhere)")
    else:
        # Current is on the base branch: create a fresh prefixed branch in the
        # new worktree.
        print("wt: creating new branch for moved changes...")
        new_branch = branch_for(ctx, name, prefix)
        if ctx.git.branch_exists(new_branch):
            die(f"branch already exists: {new_branch}")
        ctx.git.fetch_base(ctx.base_branch, quiet=True)
        if not ctx.git.worktree_add(new_wt_path, new_branch, new=True,
                                    base_ref=ctx.base_ref, fatal=False):
            pop_ok = ctx.git.stash_pop_ok(cwd_path, silent=True) if stashed else True
            if pop_ok:
                die(f"failed to create new worktree; stash restored in {cwd_name}")
            die("failed to create new worktree; stash pop failed — see `git stash list`")

    # Pop the stash in the new worktree. If it conflicts, leave it in the list.
    if stashed:
        print(f"wt: restoring changes in {new_folder}...")
        if not ctx.git.stash_pop_ok(new_wt_path):
            print(f"wt: stash pop had conflicts in {new_wt_path}; the stash is still in "
                  "`git stash list`", file=sys.stderr)

    print(f"wt: moved to {new_wt_path}")

    ctx.git.enable_untracked_cache(new_wt_path)

    if open_tab:
        ctx.tabs.open(new_wt_path, workspace=workspace)


def cmd_delete(ctx, argv):
    force, name = False, ""
    for a in argv:
        if a in ("-f", "--force"):
            force = True
        elif a.startswith("-"):
            die(f"unknown flag: {a}")
        else:
            if name:
                die("too many arguments")
            name = a

    if not name:
        die("worktree name required")
    if name in ctx.protected:
        die(f"refusing to delete protected worktree: {name}")

    wt_path = ctx.worktree_path(name)
    branch = ctx.git.branch_of(wt_path)

    if not force and not ctx.git.is_clean(wt_path):
        die(f"{name} has uncommitted changes (use -f to force)")

    ctx.git.worktree_remove(wt_path, force=force)
    print(f"wt: deleted worktree {name} (branch {branch} left intact)")


def cmd_prune(ctx, argv):
    auto_yes = False
    for a in argv:
        if a in ("-y", "--yes"):
            auto_yes = True
        else:
            die(f"unknown flag: {a}")

    fetch = start_pr_fetch(ctx)
    if fetch is None:
        die("prune needs PR/MR status — no forge configured or gh/glab missing")
    done, box, num_prefix, forge_icon = fetch
    done.wait(30)  # prune is deliberate; block for the fetch, don't time out at 1s
    prs = box.get("prs")
    if prs is None:
        die("could not fetch PR/MR status; aborting prune")

    cwd_name = ctx.current_worktree_name_or_none()
    candidates = prune_candidates(
        ctx.git.worktree_records(), prs, ctx.protected, cwd_name, ctx.base_branch
    )
    if not candidates:
        print("wt: nothing to prune")
        return

    skipped = []
    for name, branch, wt_path, pr in candidates:
        chip = pr_chip(pr, num_prefix, forge_icon)[0]
        if not ctx.git.is_clean(wt_path):
            skipped.append(name)
            print(f"  skip {name}  {chip}  (uncommitted changes)")
            continue
        if not auto_yes:
            reply = _read_reply(f"  delete {name} ({branch})  {chip}? [y/N]> ").strip()
            if reply not in ("y", "Y", "yes", "YES"):
                continue
        ctx.git.worktree_remove(wt_path)
        ctx.git.branch_delete(branch, force=True)
        print(f"wt: deleted worktree {name} and branch {branch}")

    if skipped:
        print(f"wt: skipped (uncommitted changes): {', '.join(skipped)}")


def cmd_rename(ctx, argv):
    rename_folder, positional = False, []
    for a in argv:
        if a in ("-f", "--folder"):
            rename_folder = True
        elif a.startswith("-"):
            die(f"unknown flag: {a}")
        else:
            positional.append(a)

    if len(positional) == 1:
        target_name, new_name = ctx.current_worktree_name(), positional[0]
    elif len(positional) == 2:
        target_name, new_name = positional
    else:
        die("rename: usage: wt rename [name] <new-name> [-f|--folder]")

    if target_name in ctx.protected:
        die(f"refusing to rename protected worktree: {target_name}")

    old_path = ctx.worktree_path(target_name)
    old_branch = ctx.git.branch_of(old_path)
    # A detached worktree reports "HEAD" and has no branch to rename; the
    # folder move is still worth doing on its own.
    detached = old_branch in (None, "HEAD")
    new_branch = branch_for(ctx, new_name)
    new_folder = folder_for_branch(new_branch)
    new_path = os.path.join(ctx.new_worktrees_dir, new_folder)

    if detached and not rename_folder:
        die(f"{target_name} is detached — nothing to rename "
            "(pass -f to move its folder)")
    if not detached:
        if old_branch == new_branch:
            die(f"branch is already {old_branch}")
        if ctx.git.branch_exists(new_branch):
            die(f"branch already exists: {new_branch}")

    # Do the folder move first (unreversible) so we only rename the branch if
    # the filesystem operation succeeded. A partial failure then leaves the
    # branch name unchanged, which is easy to retry.
    if rename_folder and old_path != new_path:
        if ctx.worktree_exists(new_folder):
            die(f"worktree already exists: {ctx.describe_existing(new_folder)}")
        ctx.git.worktree_move(old_path, new_path)
        print(f"wt: moved worktree folder → {new_path}")
        old_path = new_path

    if detached:
        return
    ctx.git.branch_move(old_path, old_branch, new_branch)
    print(f"wt: renamed branch {old_branch} → {new_branch}")


