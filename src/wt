def cmd_current(ctx, argv):
    """Report the cwd's worktree. Unlike the other cwd-sensitive commands this
    never dies on a cwd outside a wt-managed worktree — the Sublime status bar
    polls it for arbitrary files, where "not a worktree" is a normal answer."""
    as_json = False
    for a in argv:
        if a == "--json":
            as_json = True
        else:
            die(f"current: unknown flag: {a}")

    name, path = ctx.current_worktree_or_none()
    branch = ctx.git.branch_of(path) if path else None

    if as_json:
        print(json.dumps({"worktree": name, "branch": branch, "path": path,
                          "root": ctx.root, "layout": ctx.layout}))
    elif name:
        print(f"{name}  {branch}")
    else:
        print("wt: not in a wt-managed worktree", file=sys.stderr)
        sys.exit(1)


def cmd_foreground(ctx, argv):
    name = argv[0] if argv else ""
    if not name:
        die("foreground: worktree name required")

    cwd_path = ctx.current_worktree_path()
    cwd_name = os.path.basename(cwd_path)
    source_path = ctx.worktree_path(name)

    if cwd_path == source_path:
        die("checkout: that's the current worktree")
    if name in ctx.protected:
        die(f"refusing to consume protected worktree: {name}")

    if not ctx.git.is_clean(cwd_path):
        die(f"current worktree ({cwd_name}) has uncommitted changes")

    source_branch = ctx.git.branch_of(source_path)

    # If the source has uncommitted changes, stash them (with untracked) so we
    # can pop them after checking out the branch here. Inverse of `background`.
    stashed = False
    if not ctx.git.is_clean(source_path):
        print(f"wt: stashing changes in {name}...")
        ctx.git.stash_push(source_path, f"wt checkout from {name} {int(time.time())}")
        stashed = True

    # Reversible step first: detach the source worktree so its branch is free,
    # then do the checkout here. Only remove the source if the checkout succeeds.
    ctx.git.checkout_fatal(source_path, source_branch, detach=True, quiet_stdout=False)
    if not ctx.git.checkout_ok(cwd_path, source_branch, silent=False):
        # Recovery: reattach the branch in source and pop the stash back there.
        reattach_ok = ctx.git.checkout_ok(source_path, source_branch)
        pop_ok = ctx.git.stash_pop_ok(source_path, silent=True) if stashed else True
        if reattach_ok and pop_ok:
            die(f"checkout {source_branch} failed; source worktree {name} left intact")
        elif reattach_ok:
            die(f"checkout {source_branch} failed; source worktree {name} left intact, "
                "but stash pop failed — see `git stash list`")
        elif pop_ok:
            die(f"checkout {source_branch} failed; reattach in {name} also failed — "
                f"{name} is left detached")
        else:
            die(f"checkout {source_branch} failed AND recovery failed: {name} detached, "
                "stash still in `git stash list`")

    if stashed:
        print(f"wt: restoring changes in {cwd_name}...")
        if not ctx.git.stash_pop_ok(cwd_path):
            print(f"wt: stash pop had conflicts in {cwd_path}; the stash is still in "
                  "`git stash list`", file=sys.stderr)

    ctx.git.worktree_remove(source_path)
    print(f"wt: checked out {source_branch} in {cwd_name} (removed {name})")


def cmd_complete(ctx, argv):
    gitcore.set_quiet(True)
    what = argv[0] if argv else ""
    if what == "worktrees":
        for name in ctx.list_worktree_names():
            print(name)
    elif what == "branches":
        for branch, _ in ctx.git.worktree_records():
            print(branch)
    elif what == "checkoutable":
        # Local branches NOT already checked out in a worktree — the set that
        # `wt co <branch>` will actually accept.
        in_worktree = {branch for branch, _ in ctx.git.worktree_records()}
        for branch in ctx.git.local_branches():
            if branch not in in_worktree:
                print(branch)


# -------- setup --------


def _read_reply(prompt):
    try:
        return input(prompt)
    except EOFError:
        sys.exit(1)


def _setup_string(ctx, key, desc, current, global_scope, allow_empty=False):
    """Prompt for a single-valued string config. "-" unsets, empty keeps
    current."""
    print(key)
    print(f"  {desc}")
    print(f"  current: {current or '(unset)'}")
    reply = _read_reply("  new value> ")
    if not reply:
        print("  (unchanged)")
    elif reply == "-":
        ctx.git.config_unset(key, global_scope=global_scope)
        print("  unset.")
    elif allow_empty and reply in ("''", '""'):
        # Explicit empty: distinct from blank input (keep current) and "-" (unset).
        ctx.git.config_set(key, "", global_scope=global_scope)
        print("  set: (empty — no prefix)")
    else:
        ctx.git.config_set(key, reply, global_scope=global_scope)
        print(f"  set: {reply}")
    print()


def _setup_multi(ctx, key, desc, global_scope, current):
    """Prompt for a multi-valued config (git config --add). The new value
    replaces the prior list on that scope. "-" unsets all; empty keeps
    current."""
    print(key)
    print(f"  {desc}")
    print(f"  current: {', '.join(current) if current else '(none)'}")
    reply = _read_reply("  new values (space-separated)> ")
    if not reply:
        print("  (unchanged)")
        print()
        return
    ctx.git.config_unset(key, global_scope=global_scope, all_values=True)
    if reply == "-":
        print("  unset.")
        print()
        return
    tokens = reply.split()
    for t in tokens:
        ctx.git.config_add(key, t, global_scope=global_scope)
    print(f"  set: {', '.join(tokens)}")
    print()


def _setup_bool(ctx, key, desc, current, global_scope):
    """Prompt for a boolean config. "-" unsets, empty keeps current."""
    print(key)
    print(f"  {desc}")
    print(f"  current: {'yes' if current else 'no'}")
    reply = _read_reply("  enable? [y/n, - to unset]> ")
    if not reply:
        print("  (unchanged)")
    elif reply == "-":
        ctx.git.config_unset(key, global_scope=global_scope)
        print("  unset.")
    elif reply.lower() in ("y", "yes"):
        ctx.git.config_set(key, "true", global_scope=global_scope)
        print("  set: true")
    elif reply.lower() in ("n", "no"):
        ctx.git.config_set(key, "false", global_scope=global_scope)
        print("  set: false")
    else:
        print(f"  (unrecognized: {reply} — unchanged)")
    print()


def _setup_multi_lines(ctx, key, desc, global_scope, current):
    """Prompt for a multi-valued config whose values contain spaces (e.g. CI
    check names), so they're entered one per line rather than space-separated.
    A blank first line keeps the current list; "-" unsets all."""
    print(key)
    print(f"  {desc}")
    print("  current:", f"{len(current)} value(s)" if current else "(none)")
    for v in current:
        print(f"    - {v}")
    print("  new values, one per line; blank line to finish, '-' to unset all:")
    lines = []
    while True:
        reply = _read_reply("    > ")
        if not reply:
            break
        if reply == "-":
            ctx.git.config_unset(key, global_scope=global_scope, all_values=True)
            print("  unset.")
            print()
            return
        lines.append(reply)
    if not lines:
        print("  (unchanged)")
        print()
        return
    ctx.git.config_unset(key, global_scope=global_scope, all_values=True)
    for v in lines:
        ctx.git.config_add(key, v, global_scope=global_scope)
    print(f"  set: {len(lines)} value(s)")
    print()


def _setup_untracked_cache(ctx, global_scope):
    """Offer to enable git's untracked cache, which makes `wt list`'s
    per-worktree `git status` much faster on big trees. It's a property of
    each worktree's index, so it always goes in the shared repo config (never
    --global) and takes effect for every worktree; the cache primes on the
    next `git status`."""
    print("core.untrackedCache (repo-local)")
    print("  Speeds up `wt list` by caching the untracked-file scan in each")
    print("  worktree's index. Untracked files still count as dirty.")
    if global_scope:
        print("  (always written to this repo, even though you chose global)")
    current = ctx.git.config_get("core.untrackedCache") or ""
    print(f"  current: {current or '(unset)'}")
    if not ctx.git.test_untracked_cache():
        print("  (this filesystem doesn't support it; skipping)")
        print()
        return
    reply = _read_reply("  enable? [y/N]> ")
    if reply in ("y", "Y", "yes", "YES"):
        ctx.git.config_set("core.untrackedCache", "true")
        print("  enabled.")
    else:
        print("  (unchanged)")
    print()


def cmd_setup(ctx, argv):
    if argv:
        die("setup: takes no arguments")

    # Scope prompt: local (default) vs global. Local writes to this repo's
    # config; global writes to ~/.gitconfig as user-wide defaults.
    print("wt setup — interactive config")
    print("Press Enter to keep the current value. Type '-' to unset (revert to default).")
    print()
    print("Scope:")
    print("  [l] this repo (local)      — git config")
    print("  [g] all repos (global)     — git config --global")
    reply = _read_reply("scope [l]> ") or "l"
    if reply in ("l", "local", "L"):
        global_scope, scope_label = False, "local"
    elif reply in ("g", "global", "G"):
        global_scope, scope_label = True, "global"
    else:
        die(f"unknown scope: {reply} (expected l or g)")
    print()
    print(f"Writing to {scope_label} git config.")
    print()

    shared = gitcore.SHARED_SECTION
    _setup_string(ctx, f"{shared}.baseBranch",
                  "Base branch fetched and branched from (e.g. main, staging)",
                  ctx.base_branch, global_scope)

    _, resolved_prefix = _prefix_resolution(ctx)
    _setup_string(ctx, f"{shared}.branchPrefix",
                  "Prefix added to new branch names (default: local-part of git "
                  "user.email + /; enter '' for no prefix)",
                  resolved_prefix or "", global_scope, allow_empty=True)

    _setup_multi(ctx, f"{shared}.protectedWorktrees",
                 "Extra worktree folder names that refuse delete/rename/"
                 "foreground (space-separated; .bare and the main worktree are "
                 "always protected)",
                 global_scope, ctx.protected)

    _setup_bool(ctx, f"{shared}.nerdFont",
                "Use Nerd Font glyphs in the PR column (needs a patched font; "
                "shared with stack)",
                ctx.git.config_chain_bool("wt.nerdFont", f"{shared}.nerdFont"),
                global_scope)

    _setup_multi_lines(ctx, f"{shared}.ignoredPendingChecks",
                       "CI checks whose perpetual 'pending' shouldn't mask the "
                       "rollup result (shared with stack)",
                       global_scope,
                       ctx.git.config_chain_all(
                           "wt.ignoredPendingChecks",
                           f"{shared}.ignoredPendingChecks"))

    _setup_untracked_cache(ctx, global_scope)

    # Migration shim (added 2026-06): drop config keys from the pre-`co`
    # prefix model at the chosen scope. Safe to remove once everyone has
    # re-run `setup`.
    legacy_keys = ["wt.claudePrefix", "wt.userPrefix", "wt.defaultPrefix"]
    removed = False
    for key in legacy_keys:
        if ctx.git.config_unset(key, global_scope=global_scope, all_values=True):
            removed = True
    if removed:
        print(f"Removed deprecated config: {', '.join(legacy_keys)}")

    print()
    print("wt: setup complete. Re-run `wt -h` to see the new resolved config.")


# -------- shell integration --------

# The interactive-shell half of wt: a wrapper function so `switch` can cd the
# *current* shell (a subprocess can't), plus the zsh completion. Emitted by
# `wt init zsh`; .zshrc runs `eval "$(command wt init zsh)"`.
ZSH_INIT = r'''wt() {
  case "$1" in
    switch|s)
      local target
      target="$(command wt path "${@:2}")" || return $?
      cd "$target"
      ;;
    *)
      command wt "$@"
      ;;
  esac
}

_wt() {
  local -a subcmds worktrees branches
  subcmds=(
    'list:show worktrees + status'
    'l:show worktrees + status'
    'checkout:check out a branch in a new worktree (-b creates)'
    'co:check out a branch in a new worktree (-b creates)'
    'cob:shorthand for `co -b` (create + check out)'
    'background:relocate current branch+changes to a new worktree'
    'bg:relocate current branch+changes to a new worktree'
    'foreground:pull another worktree'"'"'s branch into cwd'
    'fg:pull another worktree'"'"'s branch into cwd'
    'rename:rename branch (optionally folder)'
    'r:rename branch (optionally folder)'
    'commit:commit -a in another worktree'
    'cm:commit -a in another worktree'
    'open:open a worktree in a new terminal tab'
    'o:open a worktree in a new terminal tab'
    'switch:cd to a worktree or checked-out branch'
    'path:print the path to a worktree (for scripts and other shells)'
    's:cd to a worktree or checked-out branch'
    'delete:remove worktree (branch left intact)'
    'd:remove worktree (branch left intact)'
    'prune:delete worktrees whose PR/MR is merged or closed'
    'p:delete worktrees whose PR/MR is merged or closed'
    'setup:interactively configure options'
    'help:show usage + resolved config'
  )
  if (( CURRENT == 2 )); then
    _describe 'wt subcommand' subcmds
  else
    case "${words[2]}" in
      switch|s)
        worktrees=("${(@f)$(command wt __complete worktrees)}")
        branches=("${(@f)$(command wt __complete branches)}")
        _describe 'worktree' worktrees
        _describe 'branch' branches
        ;;
      checkout|co)
        # Branches not already in a worktree — the set `co` will accept.
        branches=("${(@f)$(command wt __complete checkoutable)}")
        _describe 'branch' branches
        ;;
      open|o|delete|d|rename|r|commit|cm|foreground|fg)
        worktrees=("${(@f)$(command wt __complete worktrees)}")
        _describe 'worktree' worktrees
        ;;
    esac
  fi
}
compdef _wt wt'''


def cmd_init(argv):
    shell = argv[0] if argv else ""
    if shell != "zsh":
        die('init: supported shells: zsh (usage: eval "$(wt init zsh)")')
    print(ZSH_INIT)


# -------- dispatch --------


def main(argv):
    # Line-buffer stdout so progress lines interleave correctly with the
    # output of user-visible git subprocesses even when piped.
    sys.stdout.reconfigure(line_buffering=True)
    set_color(sys.stdout.isatty() and not os.environ.get("NO_COLOR"))

    if argv and argv[0] in ("--version", "-V", "version"):
        print(f"wt {gitcore.VERSION}")
        return

    # `init` runs at shell startup from any cwd — dispatch it before the
    # repo-requiring context detection.
    if argv and argv[0] == "init":
        cmd_init(argv[1:])
        return

    ctx = detect_ctx(WtGit())
    gitcore.apply_display_settings(ctx.git, "wt")

    cmd, rest = (argv[0] if argv else ""), argv[1:]
    if cmd in ("checkout", "co"):
        cmd_checkout(ctx, rest)
    elif cmd == "cob":  # shorthand for `co -b`
        cmd_checkout(ctx, rest, create=True)
    elif cmd in ("open", "o"):
        cmd_open(ctx, rest)
    elif cmd in ("background", "bg"):
        cmd_background(ctx, rest)
    elif cmd in ("list", "l"):
        cmd_list(ctx, rest)
    elif cmd in ("delete", "d"):
        cmd_delete(ctx, rest)
    elif cmd in ("prune", "p"):
        cmd_prune(ctx, rest)
    elif cmd in ("rename", "r"):
        cmd_rename(ctx, rest)
    elif cmd in ("commit", "cm"):
        cmd_commit(ctx, rest)
    elif cmd in ("switch", "s"):
        cmd_switch(ctx, rest)
    elif cmd == "path":
        cmd_path(ctx, rest)
    elif cmd == "current":
        cmd_current(ctx, rest)
    elif cmd in ("foreground", "fg"):
        cmd_foreground(ctx, rest)
    elif cmd == "setup":
        cmd_setup(ctx, rest)
    elif cmd == "__complete":
        cmd_complete(ctx, rest)
    elif cmd in ("new", "n"):
        # Deprecated 2026-06: `new` created a branch off the base — that's now
        # `co -b`. Migration shim; safe to remove once the team has switched.
        print("wt: 'new' is deprecated; use 'co -b'", file=sys.stderr)
        cmd_checkout(ctx, rest, create=True)
    elif cmd in ("-h", "--help", "help"):
        usage(ctx)
    elif cmd == "":
        usage(ctx)
        sys.exit(1)
    else:
        die(f"unknown subcommand: {cmd} (try -h)")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        print()
        sys.exit(130)
