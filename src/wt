def cmd_checkout(ctx, argv, create=False):
    """Check out a branch in a new worktree. Bare `co <branch>` checks out an
    existing branch — exact name, or a unique "<prefix>/<branch>" suffix match
    (so `co wt` finds `ryanm/wt`). `co -b <name>` creates a new branch off the
    base, adding the configured prefix only if <name> has none."""
    open_tab, workspace, name = True, False, ""
    for a in argv:
        if a == "-b":
            create = True
        elif a == "--no-tab":
            open_tab = False
        elif a == "--workspace":
            workspace = True
        # --surface was the opt-in for what is now the default.
        elif a == "--surface":
            pass
        elif a.startswith("-"):
            die(f"unknown flag: {a}")
        else:
            if name:
                die("too many arguments")
            name = a

    if not name:
        if create:
            die("checkout: branch name required (e.g. `wt co -b my-feature`)")
        die("checkout: branch name required (e.g. `wt co some-branch`, or `wt co -b` to create)")

    if create:
        branch = branch_for(ctx, name)
    else:
        branch = resolve_branch(ctx, name)
        if branch != name:
            print(f"wt: matched {name} → {branch}")
    folder = folder_for_branch(branch)
    wt_path = os.path.join(ctx.new_worktrees_dir, folder)

    if ctx.worktree_exists(folder):
        die(f"worktree already exists: {ctx.describe_existing(folder)}")

    ctx.ensure_worktrees_dir()

    if create:
        if ctx.git.branch_exists(branch):
            die(f"branch already exists: {branch} (use `wt co {branch}` to check it out)")
        print(f"wt: fetching {ctx.base_ref}...")
        ctx.git.fetch_base(ctx.base_branch)
        # --no-track: start at the base ref but don't set it as upstream; we
        # want the branch independent so pushes create a new remote branch.
        ctx.git.worktree_add(wt_path, branch, new=True, base_ref=ctx.base_ref)
        print(f"wt: created {wt_path} ({branch})")
    else:
        # git refuses if the branch is already checked out elsewhere.
        ctx.git.worktree_add(wt_path, branch)
        print(f"wt: created {wt_path} (checked out {branch})")

    ctx.git.enable_untracked_cache(wt_path)

    if open_tab:
        ctx.tabs.open(wt_path, workspace=workspace)


def cmd_open(ctx, argv):
    workspace, name = False, ""
    for a in argv:
        if a == "--workspace":
