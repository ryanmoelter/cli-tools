# -------- PR status --------
#
# `wt list` decorates each branch with its PR/MR status via one GraphQL call —
# gh or glab per the forge (see forge_kind) — started on a background thread
# before the local status scan, so the network round trip is hidden behind
# work we're doing anyway. Soft dependency: no forge CLI, or a failed call
# (offline, unauthed, unrecognized remote) simply omits the column.


def start_pr_fetch(ctx):
    """Kick off the PR fetch on a daemon thread. → (done event, result box,
    number prefix, forge icon) or None when there's nothing to fetch. The box
    holds "prs": {branch: pr|None} on success, or None on failure."""
    kind = forge_kind(ctx)
    if kind == "github":
        if not shutil.which("gh"):
            return None
        fetch = lambda branches: fetch_github_prs(branches, cwd=ctx.repo_dir)  # noqa: E731
        num_prefix, forge_icon = "#", ui.SYM_GITHUB
    elif kind == "gitlab":
        if not shutil.which("glab"):
            return None
        fullpath = gitlab_fullpath(ctx)
        if not fullpath:
            return None
        fetch = lambda branches: fetch_gitlab_prs(fullpath, branches, cwd=ctx.repo_dir)  # noqa: E731
        num_prefix, forge_icon = "!", ui.SYM_GITLAB
    else:
        return None

    # Asking only for our checked-out branches keeps the query small enough to
    # be fast (`gh pr list` with statusCheckRollup 504s on repos with big PR
    # histories).
    branches = [b for b, _ in ctx.git.worktree_records()]
    if not branches:
        return None

    done, box = start_fetch(fetch, branches)
    return done, box, num_prefix, forge_icon


# -------- list --------


def status_cluster(ahead, dirty, remote_ahead=0, remote_behind=0):
    """Plain (uncolored) "↗<ahead> ↑<ra> ↓<rb> +" cluster for a row, in that
    order — ahead of parent (the trunk), ahead/behind the remote, then dirty.
    The colored version embeds ANSI escapes, which break width math, so
    alignment is computed from this twin instead."""
    parts = []
    if ahead and ahead != "0":
        parts.append(f"{ui.SYM_AHEAD}{ahead}")
    if remote_ahead:
        parts.append(f"{ui.SYM_UP}{remote_ahead}")
    if remote_behind:
        parts.append(f"{ui.SYM_DOWN}{remote_behind}")
    if dirty:
        parts.append("+")
    return " ".join(parts)


def build_rows(ctx):
    """[(name, branch display, ahead, dirty, remote ahead, remote behind,
    has upstream)] for every worktree.

    The base branch's own row drops its ahead-of-base count — it's measured
    against the base ref, so on the base branch it just re-counts unpushed
    commits the ahead-of-remote (↑) column already shows."""
    rows = []
    names = ctx.list_worktree_names()
    # Paths come from the parallel list, not worktree_path(name): a name shared
    # by two worktrees is ambiguous by name but still has one path per row.
    paths = ctx.worktree_paths_in_list_order()
    for name, wt_path in zip(names, paths):
        display, ahead, dirty, remote_ahead, remote_behind, has_upstream = (
            ctx.worktree_status(wt_path)
        )
        if display == ctx.base_branch:
            ahead = ""
        rows.append((name, display, ahead, dirty, remote_ahead, remote_behind,
                     has_upstream))
    return rows


def prune_candidates(records, prs, protected, cwd_name, base_branch):
    """records: [(branch, wt_path)] from git.worktree_records(). → the subset
    [(name, branch, wt_path, pr)] whose PR/MR is MERGED or CLOSED, excluding
    protected worktrees, the cwd worktree, and the base branch.

    name is the path's basename, used only to describe and protect the
    candidate; deletion goes by path, so a name shared with another worktree
    can't cause the wrong one to be removed."""
    out = []
    for branch, wt_path in records:
        name = os.path.basename(wt_path)
        if name in protected or name == cwd_name or branch == base_branch:
            continue
        pr = prs.get(branch)
        if pr and pr["state"] in ("MERGED", "CLOSED"):
            out.append((name, branch, wt_path, pr))
    return out


def colorize_cluster(plain):
    """Colorize a status_cluster() twin per the shared vocabulary: ↗ (ahead of
    parent) dim, ↑/↓ (ahead/behind remote) green, + (dirty) green."""
    if not plain:
        return ""
    color = {ui.SYM_AHEAD: ui.DIM, ui.SYM_UP: ui.GREEN,
             ui.SYM_DOWN: ui.GREEN, "+": ui.GREEN}
    return " ".join(f"{color[seg[0]]}{seg}{ui.RESET}" for seg in plain.split(" "))


# Long worktree and branch names are truncated to this many columns (with an
# ellipsis) so a stray long name can't blow out the table width.
_NAME_MAX = 40


def _truncate(s, cap):
    """s clipped to cap visible columns, last char an ellipsis when clipped."""
    if len(s) <= cap:
        return s
    return s[: cap - 1] + "…" if cap >= 1 else ""


def render_list(rows, cwd_name, pr_state, pr_by_branch, num_prefix, forge_icon=None,
                trunk_branches=(), dirs=None):
    """The `wt list` table. pr_state: "on" (render per-branch), "loading" (fetch
    still in flight → dim ellipsis chip), "wait" (timed out → dim net-off chip),
    "error" (fetch failed → red net-off chip), or "off" (no forge CLI → column
    omitted). Branches in trunk_branches render as no-PR, and a branch with no
    upstream renders local-only in every state but "off" — the forge can't have
    a PR for a branch it has never seen. Long worktree and branch names are
    truncated to _NAME_MAX.

    dirs: display locations parallel to rows (`wt list --paths`), appended as a
    trailing dim column. Returns the rendered text (no trailing newline)."""
    name_disp = [_truncate(name, _NAME_MAX) for name, *_ in rows]
    max_name = max(len(n) for n in name_disp)

    def field_width(branch, plain):
        """Visible width of the "<branch>  <cluster>" field (no cluster → just
        the branch, no trailing space)."""
        return len(branch) + (2 + len(plain) if plain else 0)

    # The status cluster rides just after the (truncated) branch name in one
    # shared field, widened to the longest such pair.
    disp = {branch: _truncate(branch, _NAME_MAX)
            for _, branch, *_ in rows}
    max_branch_status = max(
        field_width(disp[branch], status_cluster(a, d, ra, rb))
        for _, branch, a, d, ra, rb, _ in rows
    )

    lines = []
    for i, (name, branch_disp, ahead, dirty, remote_ahead, remote_behind,
            has_upstream) in enumerate(rows):
        marker = "→" if name == cwd_name else " "
        branch_name = disp[branch_disp]
        plain = status_cluster(ahead, dirty, remote_ahead, remote_behind)
        colored = colorize_cluster(plain)
        branch_status = f"{branch_name}  {colored}" if plain else branch_name
        # Pad by the plain field width — the colored cluster's ANSI escapes
        # would otherwise skew str formatting widths.
        pad = " " * (max_branch_status - field_width(branch_name, plain))

        if not has_upstream and pr_state != "off":
            # A branch that was never pushed can't have a PR, so the fetch has
            # nothing to say about it — render local-only in every state rather
            # than showing it as loading or unavailable.
            pr_str = branch_pr_chip(None, False, forge_icon, num_prefix)[0]
        elif pr_state == "on":
            pr = None if branch_disp in trunk_branches else pr_by_branch.get(branch_disp)
            pr_str = branch_pr_chip(pr, has_upstream, forge_icon, num_prefix)[0]
        elif pr_state == "loading":
            pr_str = pr_loading_chip(forge_icon)[0]
        elif pr_state == "wait":
            pr_str = pr_net_off_chip(forge_icon, failed=False)[0]
        elif pr_state == "error":
            pr_str = pr_net_off_chip(forge_icon, failed=True)[0]
        else:
            pr_str = ""

        line = f"{marker} {name_disp[i]:<{max_name}}  {branch_status}{pad}  {pr_str}"
        if dirs:
            line = f"{line.rstrip()}  {ui.DIM}{dirs[i]}{ui.RESET}"
        if name == cwd_name:
            # Bold the whole row. Interior segments end in ui.RESET (which also
            # clears bold), so re-arm bold after each one.
            line = f"{ui.BOLD}{line.replace(ui.RESET, ui.RESET + ui.BOLD)}{ui.RESET}"
        lines.append(line)
    return "\n".join(lines)


def build_list_json(rows, cwd_name, pr_state, pr_by_branch, paths, trunk_branches=()):
    """The `wt list --json` payload: {"pr_state", "worktrees": [...]}.

    Pure twin of render_list, for machine consumers (the Sublime plugin). Each
    worktree carries its absolute path, which the plain table omits unless
    --paths is passed. paths runs parallel to rows rather than being keyed by
    name, since names are not unique. pr_state rides at the top level so a
    consumer can tell "no PR" (pr: null under state "on") from "PR status
    unavailable" (any other state)."""
    worktrees = []
    for i, (name, branch, ahead, dirty, remote_ahead, remote_behind,
            has_upstream) in enumerate(rows):
        pr = None
        if pr_state == "on" and branch not in trunk_branches:
            pr = pr_by_branch.get(branch)
        worktrees.append({
            "name": name,
            "path": paths[i] if i < len(paths) else None,
            "branch": branch,
            "current": name == cwd_name,
            # build_rows blanks the base branch's ahead count; "" → 0 so the
            # field is always a number.
            "ahead": int(ahead) if ahead else 0,
            "dirty": bool(dirty),
            "remote_ahead": remote_ahead,
            "remote_behind": remote_behind,
            "has_upstream": has_upstream,
            "pr": {
                "number": pr["number"],
                "state": pr["state"],
                "is_draft": pr.get("isDraft", False),
                "url": pr.get("url"),
                "title": pr.get("title"),
            } if pr else None,
        })
    return {"pr_state": pr_state, "worktrees": worktrees}


# A GUI consumer can afford to wait longer than the interactive table for PR
# status; showing it is better than reporting "wait" and rendering no column.
_JSON_PR_WAIT = 3.0

# The table paints the local state immediately and never waits on the forge, so
# the fetch gets a budget well past what a blocking wait could afford.
_LIST_PR_TOTAL = 8.0


def print_list_live(rows, cwd_name, fetch, trunk_branches, live, dirs=None):
    """Print the list table, filling in the PR column as the fetch lands.

    On a TTY the local table paints immediately with dim loading chips, redrawn
    in place once the fetch resolves (or the budget runs out). Off a TTY there is
    nothing to redraw into, so block for the whole budget and print once — a
    piped consumer never has to skip a stale frame."""
    if fetch is None:
        print(render_list(rows, cwd_name, "off", {}, "#", None, trunk_branches, dirs))
        return

    done, box, num_prefix, forge_icon = fetch

    def table(pr_state, pr_by_branch):
        return render_list(rows, cwd_name, pr_state, pr_by_branch, num_prefix,
                           forge_icon, trunk_branches, dirs)

    def collect(timeout):
        return resolve_pr_state(box) if done.wait(timeout) else ("wait", {})

    if not live:
        print(table(*collect(_LIST_PR_TOTAL)))
        return

    provisional = table("loading", {})
    print(provisional)
    resolved = table(*collect(_LIST_PR_TOTAL))
    sys.stdout.write(redraw_prefix(provisional.count("\n") + 1))
    print(resolved)


def cmd_list(ctx, argv):
    as_json, show_paths = False, False
    for a in argv:
        if a == "--json":
            as_json = True
        elif a in ("--paths", "--dirs"):
            show_paths = True
        else:
            die(f"list: unknown flag: {a}")

    # Start the PR fetch first so it overlaps the per-worktree status scan.
    fetch = start_pr_fetch(ctx)

    cwd_name = ctx.current_worktree_name_or_none()
    rows = build_rows(ctx)
    if not rows:
        if as_json:
            print(json.dumps({"pr_state": "off", "worktrees": []}))
        else:
            print(f"wt: no worktrees for {ctx.root}")
        return

    if as_json:
        # A single blocking wait: the payload is parsed, not watched, so there is
        # nothing to fill in later. On timeout the daemon thread is abandoned.
        pr_state, pr_by_branch = "off", {}
        if fetch is not None:
            done, box, _, _ = fetch
            pr_state, pr_by_branch = (resolve_pr_state(box)
                                      if done.wait(_JSON_PR_WAIT) else ("wait", {}))
        print(json.dumps(build_list_json(rows, cwd_name, pr_state, pr_by_branch,
                                         ctx.worktree_paths_in_list_order(),
                                         ctx.trunk_branches)))
        return

    dirs = None
    if show_paths:
        dirs = [display_location(p, ctx.root)
                for p in ctx.worktree_paths_in_list_order()]
    print_list_live(rows, cwd_name, fetch, ctx.trunk_branches, sys.stdout.isatty(),
                    dirs)


