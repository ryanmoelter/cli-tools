# -------- terminal tabs --------


class TabOpener:
    """Opens a directory in a new terminal tab/workspace. Prefers cmux when
    we're running inside it (cmux embeds Ghostty, so TERM_PROGRAM can't tell
    them apart — the CMUX_* env vars can), then standalone Ghostty via
    AppleScript, then a printed path + cd hint. Every path is best-effort:
    callers treat a failure to open as non-fatal.

    All process/env access goes through _which/_run/env/platform so tests can
    substitute fakes and drive the driver-selection logic directly."""

    def __init__(self, env=None, platform=None):
        self.env = os.environ if env is None else env
        self.platform = sys.platform if platform is None else platform

    def _which(self, name):
        return shutil.which(name)

    def _run(self, args, input_=None):
        """→ (returncode, stdout). Never raises."""
        try:
            p = subprocess.run(
                args, text=True, input=input_,
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            )
            return p.returncode, p.stdout
        except OSError:
            return 1, ""

    def open(self, dir_, workspace=False):
        if workspace:
            if self._try_cmux(dir_):
                return
        elif self._try_cmux_surface(dir_):
            return
        if self._try_ghostty(dir_):
            return
        print(f"wt: {dir_}")
        print(f'wt: (cd "{dir_}")')

    def _try_cmux_surface(self, dir_):
        # A tab ("surface") in the *current* cmux workspace: a worktree
        # belongs to the task at hand rather than standing alone, so this is
        # the default. `new-surface` has no --cwd, so the cd is typed into the
        # fresh shell (send + enter), then the tab is named after the worktree
        # folder. Opens unfocused: the caller's tab keeps focus and this one
        # waits alongside it. cd/rename failures are tolerated (the surface
        # exists); a failed create falls back to Ghostty, never to a new
        # workspace — that is only ever explicit, via --workspace.
        if not (self.env.get("CMUX_WORKSPACE_ID") or self.env.get("CMUX_SOCKET_PATH")):
            return False
        cmux_bin = self.env.get("CMUX_BUNDLED_CLI_PATH") or "cmux"
        if not (os.access(cmux_bin, os.X_OK) or self._which(cmux_bin)):
            return False
        rc, out = self._run(
            [cmux_bin, "new-surface", "--type", "terminal", "--focus", "false"]
        )
        if rc != 0:
            return False
        ref = self._parse_surface_ref(out)
        if not ref:
            return False
        self._run([cmux_bin, "send", "--surface", ref, f'cd "{dir_}"'])
        self._run([cmux_bin, "send-key", "--surface", ref, "enter"])
        self._run([cmux_bin, "rename-tab", "--surface", ref, os.path.basename(dir_)])
        return True

    def _try_cmux(self, dir_):
        # Open the dir in a new workspace (only on --workspace), placed in the
        # *same group* as the current workspace so a worktree lands next to
        # its siblings (e.g.
        # under "Dotfiles + tools") rather than ungrouped. If the current
        # workspace is in no group, fall back to the bare `cmux <path>` form
        # (not `cmux open`, which makes a file-preview tab). On a cmux too old
        # for `create --group` the create still succeeds (just ungrouped), so
        # we never double-open. Use the bundled CLI when cmux points at it.
        # After a grouped create we also copy the group's dominant color onto
        # the new workspace (see _apply_group_color) so it matches its siblings.
        if not (self.env.get("CMUX_WORKSPACE_ID") or self.env.get("CMUX_SOCKET_PATH")):
            return False
        cmux_bin = self.env.get("CMUX_BUNDLED_CLI_PATH") or "cmux"
        if not (os.access(cmux_bin, os.X_OK) or self._which(cmux_bin)):
            return False
        ws_id = self.env.get("CMUX_WORKSPACE_ID")
        group_id = ""
        if ws_id:
            rc, out = self._run([cmux_bin, "rpc", "workspace.group.list"])
            if rc == 0:
                group_id = self._group_of(out, ws_id)
        if group_id:
            rc, create_out = self._run([
                cmux_bin, "workspace", "create", "--cwd", dir_,
                "--group", group_id, "--group-placement", "afterCurrent",
                "--group-reference", ws_id, "--focus", "true",
            ])
            if rc == 0:
                self._apply_group_color(cmux_bin, out, group_id, ws_id, create_out)
                return True
        rc, _ = self._run([cmux_bin, dir_])
        return rc == 0

    def _apply_group_color(self, cmux_bin, groups_json, group_id, ref_ws_id, create_out):
        """Paint the just-created workspace with the group's most popular
        color so a new worktree matches its colored siblings. Pure polish:
        every step is best-effort and a failure just leaves the workspace at
        cmux's default. A group with no colored members is left alone."""
        new_ref = self._parse_created_ref(create_out)
        if not new_ref:
            return
        member_ids = self._members_of(groups_json, group_id)
        if not member_ids:
            return
        rc, ws_out = self._run(
            [cmux_bin, "--id-format", "both", "workspace", "list", "--json"]
        )
        if rc != 0:
            return
        color = self._dominant_color(ws_out, member_ids, ref_ws_id)
        if not color:
            return
        self._run([
            cmux_bin, "workspace-action", "--action", "set-color",
            "--color", color, "--workspace", new_ref,
        ])

    @staticmethod
    def _group_of(rpc_json, ws_id):
        """id of the first group containing ws_id, or ""."""
        try:
            data = json.loads(rpc_json)
        except (json.JSONDecodeError, TypeError):
            return ""
        for group in data.get("groups") or []:
            if ws_id in (group.get("member_workspace_ids") or []):
                return group.get("id") or ""
        return ""

    @staticmethod
    def _members_of(rpc_json, group_id):
        """member_workspace_ids (UUIDs) for group_id, or []. Twin of
        _group_of, keyed the other way (group → members)."""
        try:
            data = json.loads(rpc_json)
        except (json.JSONDecodeError, TypeError):
            return []
        for group in data.get("groups") or []:
            if group.get("id") == group_id:
                return group.get("member_workspace_ids") or []
        return []

    @staticmethod
    def _parse_created_ref(create_out):
        """'workspace:NN' from `workspace create`'s "OK workspace:NN" line,
        or "" when the output isn't recognizable."""
        m = re.match(r"OK (workspace:\S+)", create_out.strip())
        return m.group(1) if m else ""

    @staticmethod
    def _parse_surface_ref(create_out):
        """'surface:NN' from `new-surface`'s "OK surface:NN pane:NN ..." line,
        or "" when the output isn't recognizable."""
        m = re.match(r"OK (surface:\S+)", create_out.strip())
        return m.group(1) if m else ""

    @staticmethod
    def _dominant_color(workspaces_json, member_ids, ref_ws_id):
        """Most-used custom_color among member_ids, per `workspace list --json`
        (members matched on the UUID `id` field). A tie is broken toward the
        reference workspace's own color when it's among the leaders, else
        first-seen order. "" when no member is colored or the JSON is bad."""
        try:
            data = json.loads(workspaces_json)
        except (json.JSONDecodeError, TypeError):
            return ""
        members = set(member_ids)
        counts, order, ref_color = {}, [], ""
        for ws in data.get("workspaces") or []:
            wid = ws.get("id")
            if wid not in members:
                continue
            color = ws.get("custom_color")
            if not color:
                continue
            if color not in counts:
                order.append(color)
            counts[color] = counts.get(color, 0) + 1
            if wid == ref_ws_id:
                ref_color = color
        if not counts:
            return ""
        top = max(counts.values())
        if ref_color and counts[ref_color] == top:
            return ref_color
        return next(c for c in order if counts[c] == top)

    def _try_ghostty(self, dir_):
        # Escape backslashes and double-quotes so paths with those chars don't
        # break (or smuggle) AppleScript string literals.
        if not self.platform.startswith("darwin") or not self._which("osascript"):
            return False
        esc = dir_.replace("\\", "\\\\").replace('"', '\\"')
        script = (
            'tell application "Ghostty"\n'
            "  set cfg to new surface configuration\n"
            f'  set initial working directory of cfg to "{esc}"\n'
            "  new tab with configuration cfg in front window\n"
            "end tell"
        )
        rc, _ = self._run(["osascript"], input_=script)
        return rc == 0


# -------- git backend --------
# All git subprocess access for wt; tests substitute fakes at the Ctx seam.


class WtGit(gitcore.ConfigMixin):
    def __init__(self):
        self.repo_dir = None  # set once the layout is detected

    # --- raw runners; out: "inherit" (user-visible), "quiet" (stdout
    # suppressed, stderr visible), "silent" (both suppressed) ---

    def _rc(self, args, out="silent"):
        stdout = None if out == "inherit" else subprocess.DEVNULL
        stderr = subprocess.DEVNULL if out == "silent" else None
        return subprocess.run(args, stdout=stdout, stderr=stderr).returncode

    def _repo_git(self, *args):
        return ["git", "-C", self.repo_dir, *args]

    # Config reads/writes anchor to the repo, not the cwd.
    def _git_cmd(self, *args):
        return self._repo_git(*args)

    def visible_ok(self, args):
        return self._rc(args, out="inherit") == 0

    def visible_fatal(self, args, quiet_stdout=False):
        """Mirror zsh's `set -e`: on failure exit with git's own code (its
        error output has already gone to the terminal)."""
        rc = self._rc(args, out="quiet" if quiet_stdout else "inherit")
        if rc != 0:
            sys.exit(rc)

    def silent_ok(self, args):
        return self._rc(args, out="silent") == 0

    def out_or_none(self, args):
        p = run_(args, check=False)
        return p.stdout.rstrip("\n") if p.returncode == 0 else None

    # --- bootstrap (plain cwd git) ---

    def toplevel(self):
        return self.out_or_none(["git", "rev-parse", "--show-toplevel"])

    def common_dir(self, root):
        return self.out_or_none(["git", "-C", root, "rev-parse", "--git-common-dir"])

    # --- repo-anchored ---

    def origin_url(self):
        return self.out_or_none(self._repo_git("remote", "get-url", "origin"))

    def origin_head(self):
        return self.out_or_none(
            self._repo_git("symbolic-ref", "--short", "refs/remotes/origin/HEAD")
        )

    def branch_exists(self, b):
        return self.silent_ok(self._repo_git("show-ref", "--verify", f"refs/heads/{b}"))

    def local_branches(self):
        out = self.out_or_none(
            self._repo_git("for-each-ref", "--format=%(refname:short)", "refs/heads")
        )
        return out.splitlines() if out else []

    def worktree_entries(self):
        """[(path, branch or None)] for every worktree git knows about, the main
        worktree first and detached HEADs included. Single source of truth for
        parsing `git worktree list --porcelain`, whose blank-line-separated
        records are `worktree <path>`, `HEAD <sha>`, then either
        `branch refs/heads/<name>` or `detached`.

        A record is flushed when the next one starts rather than on its `branch`
        line, so a detached worktree — which has no such line — still yields an
        entry."""
        out = self.out_or_none(self._repo_git("worktree", "list", "--porcelain")) or ""
        entries, wt_path, branch = [], None, None
        for line in out.splitlines():
            if line.startswith("worktree "):
                if wt_path is not None:
                    entries.append((wt_path, branch))
                wt_path, branch = line[len("worktree "):], None
            elif line.startswith("branch refs/heads/"):
                branch = line[len("branch refs/heads/"):]
        if wt_path is not None:
            entries.append((wt_path, branch))
        return entries

    def worktree_records(self):
        """[(branch, path)] per worktree, skipping detached HEADs — for callers
        that act on the branch itself (PR lookup, branch deletion, completion)."""
        return [(branch, path) for path, branch in self.worktree_entries()
                if branch is not None]

    def fetch_base(self, base_branch, quiet=False):
        args = self._repo_git("fetch", "origin", base_branch)
        if quiet:
            self.silent_ok(args)  # best-effort
        else:
            self.visible_fatal(args)

    def worktree_add(self, wt_path, branch, new=False, base_ref=None, fatal=True):
        if new:
            args = self._repo_git("worktree", "add", "--no-track", "-b", branch, wt_path, base_ref)
        else:
            args = self._repo_git("worktree", "add", wt_path, branch)
        if fatal:
            self.visible_fatal(args)
            return True
        return self.visible_ok(args)

    def worktree_remove(self, wt_path, force=False):
        args = self._repo_git("worktree", "remove", *(["--force"] if force else []), wt_path)
        self.visible_fatal(args)

    def branch_delete(self, branch, force=False):
        self.visible_fatal(self._repo_git("branch", "-D" if force else "-d", branch))

    def worktree_move(self, old_path, new_path):
        self.visible_fatal(self._repo_git("worktree", "move", old_path, new_path))

    # --- per-worktree ---

    def branch_of(self, wt_path):
        p = run_(["git", "-C", wt_path, "rev-parse", "--abbrev-ref", "HEAD"], check=False)
        if p.returncode != 0:
            sys.exit(p.returncode)
        return p.stdout.strip()

    def is_clean(self, wt_path):
        p = run_(["git", "-C", wt_path, "status", "--porcelain"], check=False)
        if p.returncode != 0:
            sys.exit(p.returncode)
        return not p.stdout.strip()

    def status_v2_lines(self, wt_path):
        out = self.out_or_none(["git", "-C", wt_path, "status", "-b", "--porcelain=v2"])
        return out.splitlines() if out else []

    def short_head(self, wt_path):
        return self.out_or_none(["git", "-C", wt_path, "rev-parse", "--short", "HEAD"])

    def ahead_count(self, wt_path, base_ref):
        """Commits ahead of base_ref as a string, "" when unanswerable."""
        out = self.out_or_none(
            ["git", "-C", wt_path, "rev-list", "--count", f"{base_ref}..HEAD"]
        )
        return out if out is not None else ""

    def checkout_ok(self, wt_path, ref, detach=False, silent=True):
        args = ["git", "-C", wt_path, "checkout"] + (["--detach"] if detach else []) + [ref]
        return self.silent_ok(args) if silent else self.visible_ok(args)

    def checkout_fatal(self, wt_path, ref, detach=False, quiet_stdout=True):
        args = ["git", "-C", wt_path, "checkout"] + (["--detach"] if detach else []) + [ref]
        self.visible_fatal(args, quiet_stdout=quiet_stdout)

    def stash_push(self, wt_path, msg):
        self.visible_fatal(
            ["git", "-C", wt_path, "stash", "push", "--include-untracked", "-m", msg]
        )

    def stash_pop_ok(self, wt_path, silent=False):
        args = ["git", "-C", wt_path, "stash", "pop"]
        return self.silent_ok(args) if silent else self.visible_ok(args)

    def branch_move(self, wt_path, old, new):
        self.visible_fatal(["git", "-C", wt_path, "branch", "-m", old, new])

    def commit_a(self, wt_path, extra_args):
        return self._rc(["git", "-C", wt_path, "commit", "-a", *extra_args], out="inherit")

    def enable_untracked_cache(self, wt_path):
        # No-op (and silent) where unsupported; never fails the caller.
        self.silent_ok(["git", "-C", wt_path, "update-index", "--untracked-cache"])

    def test_untracked_cache(self):
        return self.silent_ok(self._repo_git("update-index", "--test-untracked-cache"))


# -------- layout + config context --------


class Ctx:
    """Layout + resolved config, built once in main(). The list-facing methods
    (list_worktree_names / worktree_path / worktree_paths_in_list_order /
    worktree_status / current_worktree_name_or_none / current_worktree_or_none)
    are the seam FakeWtCtx duck-types in tests.

    Worktrees are discovered from git's own registry, so one checked out
    anywhere on disk — by wt, by another tool, or by hand — is recognized.
    new_worktrees_dir only decides where wt puts the ones it creates."""

    def __init__(self, git, layout, root, repo_dir, new_worktrees_dir, main_name):
        self.git = git
        self.layout = layout  # "bare" | "standard"
        self.root = root
        self.repo_dir = repo_dir
        self.new_worktrees_dir = new_worktrees_dir
        self.main_name = main_name
        self.tabs = TabOpener()
        self._registry_cache = None

        head = git.origin_head()
        origin_default = head.removeprefix("origin/") if head else ""
        base = (git.config_chain("wt.baseBranch",
                                 f"{gitcore.SHARED_SECTION}.baseBranch")
                or origin_default or "main")
        self.base_branch = base
        self.base_ref = f"origin/{base}"
        # A trunk branch never has a PR worth showing, so `wt list` renders it
        # as no-PR rather than surfacing some long-dead PR that targeted it.
        self.trunk_branches = {b for b in (base, origin_default) if b}

        # Always protect .bare and the main worktree, on top of any
        # user-configured names.
        self.protected = git.config_chain_all(
            "wt.protected", f"{gitcore.SHARED_SECTION}.protectedWorktrees")
        if layout == "bare":
            self.protected.append(".bare")
        elif main_name:
            self.protected.append(main_name)

        # Branch prefix is resolved lazily — a missing user.email shouldn't
        # break unrelated commands like `wt list`. The resolved flag guards the
        # cache so an explicitly-empty prefix isn't mistaken for "not yet
        # resolved".
        self._prefix = ""
        self._prefix_resolved = False

    def _registry(self):
        """{name: [path, ...]} over every worktree git has registered, keyed by
        the folder's basename. Paths collect into a list because names are no
        longer unique by construction — two worktrees in different parent
        directories can share a basename. Built once per run; wt is one-shot."""
        if self._registry_cache is None:
            registry = {}
            for path, _ in self.git.worktree_entries():
                if path == self.root:
                    # Bare layout's root is no worktree, so it has no name.
                    name = self.main_name
                else:
                    name = os.path.basename(path)
                    # Bare layout registers its own .bare dir, which holds no
                    # checkout and isn't somewhere to work. Only linked
                    # worktrees are filtered this way — the main worktree keeps
                    # its name even in a dot-directory like ~/.dotfiles.
                    if name.startswith("."):
                        continue
                if not name:
                    continue
                registry.setdefault(name, []).append(path)
            self._registry_cache = registry
        return self._registry_cache

    def _rows(self):
        """[(name, path)] in display order: the main worktree first in standard
        layout, then by name and path. The single ordering both
        list_worktree_names and worktree_paths_in_list_order read, so the two
        can't drift out of alignment."""
        rows = sorted((name, path)
                      for name, paths in self._registry().items()
                      for path in paths)
        if self.layout == "standard":
            rows.sort(key=lambda r: r[0] != self.main_name)
        return rows

    def list_worktree_names(self):
        """Every worktree's name, in display order. A name shared by several
        worktrees appears once per worktree, so `wt list` shows them all."""
        return [name for name, _ in self._rows()]

    def worktree_paths_in_list_order(self):
        """Paths aligned with list_worktree_names(), so a duplicated name still
        maps to distinct paths. Needed because worktree_path() refuses to
        resolve an ambiguous name."""
        return [path for _, path in self._rows()]

    def worktree_path(self, name):
        """Map name → absolute path. Dies if no worktree has that name, or if
        several do — an ambiguous name has no single right answer, and silently
        picking one risks acting on the wrong worktree."""
        if not name:
            die("worktree name required")
        paths = self._registry().get(name)
        if not paths:
            die(f"no worktree named {name}")
        if len(paths) > 1:
            listed = "\n".join(f"    {p}" for p in sorted(paths))
            die(f"ambiguous name {name} — {len(paths)} worktrees match:\n{listed}")
        return paths[0]

    def worktree_status(self, wt_path):
        """(branch display, ahead count as str, dirty flag, remote ahead,
        remote behind, has upstream).

        Branch, dirty, and remote ahead/behind come from one
        `git status -b --porcelain=v2`: its `# branch.*` headers give the branch
        (or detached sha) and the `# branch.ab +A -B` upstream delta, and any
        non-# line means the tree is dirty (tracked edits or untracked files).
        With core.untrackedCache enabled this is markedly cheaper than scanning
        the tree fresh each time."""
        head, dirty, remote_ahead, remote_behind = None, 0, 0, 0
        has_upstream = False
        for line in self.git.status_v2_lines(wt_path):
            if line.startswith("# branch.head "):
                head = line[len("# branch.head "):]
            elif line.startswith("# branch.ab "):
                # "+A -B"; the header is present only when there's an upstream.
                a, b = line[len("# branch.ab "):].split()
                remote_ahead, remote_behind = int(a), -int(b)
                has_upstream = True
            elif line.startswith("#"):
                pass
            else:
                dirty = 1  # any tracked/untracked change
        if not head:
            display = "?"
        elif head == "(detached)":
            display = f"{self.git.short_head(wt_path) or '?'} (detached)"
        else:
            display = head
        # Ahead is measured against base_ref (the trunk), not the branch's own
        # upstream, so it can't come from porcelain v2's `branch.ab`.
        ahead = self.git.ahead_count(wt_path, self.base_ref)
        return display, ahead, dirty, remote_ahead, remote_behind, has_upstream

    def _registered_paths(self):
        return {p for paths in self._registry().values() for p in paths}

    def current_worktree_path(self):
        top = self.git.toplevel()
        if not top:
            die("not inside a git worktree")
        if top not in self._registered_paths():
            die(f"cwd ({top}) is not a worktree of {self.root}")
        return top

    def current_worktree_name(self):
        top = self.current_worktree_path()
        if self.layout == "standard" and top == self.root:
            return self.main_name
        return os.path.basename(top)

    def current_worktree_name_or_none(self):
        """Non-dying twin of current_worktree_name, for `wt list`'s marker."""
        return self.current_worktree_or_none()[0]

    def current_worktree_or_none(self):
        """(name, path) for the cwd's worktree, or (None, None). The path comes
        straight from git rather than a name lookup, so this still answers
        inside a worktree whose name it shares with another."""
        top = self.git.toplevel()
        if not top or top not in self._registered_paths():
            return None, None
        if self.layout == "standard" and top == self.root:
            return self.main_name, top
        return os.path.basename(top), top

    def worktree_exists(self, name):
        return name in self._registry()

    def describe_existing(self, name):
        """Where the worktree(s) claiming `name` actually are — the conflict may
        sit outside new_worktrees_dir, so the path can't be assumed."""
        return ", ".join(sorted(self._registry().get(name, [])))

    def ensure_worktrees_dir(self):
        """Standard layout: ensure the dir new worktrees go in exists and is
        self-ignored."""
        if self.layout != "standard":
            return
        os.makedirs(self.new_worktrees_dir, exist_ok=True)
        gitignore = os.path.join(self.new_worktrees_dir, ".gitignore")
        if not os.path.isfile(gitignore):
            with open(gitignore, "w") as f:
                f.write("*\n")


def detect_ctx(git):
    root = git.toplevel()
    if root is None:
        die("not inside a git repo")
    common = git.common_dir(root)
    if common is None:
        die("failed to resolve git common dir")
    # Make it absolute (--git-common-dir can be relative to cwd).
    if not os.path.isabs(common):
        common = os.path.join(root, common)
    layout_root = os.path.dirname(common)
    if os.path.basename(common) == ".bare":
        git.repo_dir = common  # .bare dir — git -C anchor
        return Ctx(git, "bare", layout_root,
                   repo_dir=common,
                   new_worktrees_dir=layout_root,  # new worktrees go here
                   main_name="")                   # no main worktree in bare layout
    # Git's common dir is <main-worktree>/.git, so dirname gives the main
    # worktree regardless of which linked worktree we're invoked from.
    git.repo_dir = layout_root  # main worktree doubles as the git -C anchor
    return Ctx(git, "standard", layout_root,
               repo_dir=layout_root,
               new_worktrees_dir=os.path.join(layout_root, ".worktrees"),
               main_name=os.path.basename(layout_root))


# -------- helpers --------


def _prefix_resolution(ctx):
    """(ok, prefix). ok=False means user.email can't supply a default."""
    if ctx._prefix_resolved:
        return True, ctx._prefix
    # The chain yields None only when neither key is set, so an explicit empty
    # value (`git config wt.branchPrefix ""`) is honored as "no prefix" rather
    # than falling through to the email-derived default.
    cfg = ctx.git.config_chain("wt.branchPrefix",
                               f"{gitcore.SHARED_SECTION}.branchPrefix")
    if cfg is not None:
        prefix = cfg
    else:
        email = ctx.git.config_get("user.email") or ""
        local_part = email.split("@")[0]
        if not email or local_part == email:
            return False, None
        prefix = local_part + "/"
    ctx._prefix, ctx._prefix_resolved = prefix, True
    return True, prefix


def branch_prefix(ctx):
    ok, prefix = _prefix_resolution(ctx)
    if not ok:
        die("can't derive wt.branchPrefix: git user.email is missing or has no '@'. "
            "Run: git config wt.branchPrefix foo/ "
            "(or `git config wt.branchPrefix \"\"` for no prefix)")
    return prefix


def branch_for(ctx, name, prefix=None):
    """Add the branch prefix if it isn't already present. prefix=None resolves
    the configured prefix; an explicit "" means "no prefix"."""
    if prefix is None:
        prefix = branch_prefix(ctx)
    if prefix and name.startswith(prefix):
        return name
    return prefix + name


def folder_for_branch(branch):
    """Strip any leading "<prefix>/" so folder names stay prefix-agnostic —
    both ryanmoelter/foo and cc/foo map to folder "foo". Any remaining slashes
    get flattened to dashes so the folder stays one level deep
    (cc/feature/thing → feature-thing)."""
    return branch.split("/", 1)[-1].replace("/", "-")


def resolve_branch(ctx, name):
    """Resolve a checkout target to an existing local branch. Exact match
    wins; otherwise fall back to a single branch ending in "/<name>" (so
    `co wt` finds `ryanm/wt`). Dies listing the candidates when zero or more
    than one suffix-match exists."""
    if ctx.git.branch_exists(name):
        return name
    matches = [b for b in ctx.git.local_branches() if b.endswith("/" + name)]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        die(f"no such branch: {name} (use `wt co -b {name}` to create one)")
    die(f"ambiguous branch: {name} matches {', '.join(matches)}; use the full name")


def forge_kind(ctx):
    """Which forge the PR column talks to: "github", "gitlab", or "none".
    wt.forge overrides (escape hatch for self-hosted domains the host sniff
    can't classify); otherwise sniffed from origin's URL host."""
    return forge.forge_kind(
        ctx.git.origin_url(),
        ctx.git.config_chain("wt.forge", f"{gitcore.SHARED_SECTION}.forge"),
    )


def gitlab_fullpath(ctx):
    """Project full path ("group/sub/repo") from origin's URL, for GraphQL's
    project(fullPath:). None when unresolvable."""
    return forge.gitlab_fullpath(ctx.git.origin_url())


def display_location(wt_path, root):
    """A worktree's directory for the `--paths` column: relative to the repo
    root when it lives inside it (the common case, kept short), absolute
    otherwise so a worktree checked out elsewhere stands out. The root itself
    renders as "." — it has no relative form."""
    if wt_path is None:
        return ""
    if wt_path == root:
        return "."
    if wt_path.startswith(root + "/"):
        return os.path.dirname(wt_path[len(root) + 1:]) or "."
    return os.path.dirname(wt_path)


def path_for_branch(ctx, target):
    """The worktree path that has branch `target` checked out, or None."""
    for branch, wt_path in ctx.git.worktree_records():
        if branch == target:
            return wt_path
    return None


