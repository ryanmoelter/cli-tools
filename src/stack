    if shell != "zsh":
        die('init: supported shells: zsh (usage: eval "$(stack init zsh)")')
    print(STACK_ZSH_INIT)


def main(argv):
    set_color(sys.stdout.isatty() and not os.environ.get("NO_COLOR"))
    if argv and argv[0] in ("--version", "-V", "version"):
        print(f"stack {gitcore.VERSION}")
        return

    # `init` runs at shell startup from any cwd, so it precedes anything that
    # needs a repo.
    if argv and argv[0] == "init":
        cmd_init(argv[1:])
        return
    if not argv or argv[0] in ("help", "-h", "--help"):
        # The symbol key reflects the configured glyph set and forge, so the
        # help path needs both resolved even though it runs no command.
        git = Git() if Git().git_ok("rev-parse", "--git-dir") else None
        if git is not None:
            gitcore.apply_display_settings(git, "stack")
        usage(select_forge(git) if git is not None else None, git)
        return
    cmd, rest = argv[0], argv[1:]
    dispatch = {
        "list": cmd_list, "l": cmd_list,
        "la": lambda g, h, a: cmd_list(g, h, ["--all", *a]),
        "create": cmd_create, "c": cmd_create,
        "split": cmd_split,
        "track": cmd_track,
        "untrack": cmd_untrack,
        "checkout": cmd_checkout, "co": cmd_checkout,
        "prev": lambda g, h, a: cmd_nav("prev", g, h, a),
        "next": lambda g, h, a: cmd_nav("next", g, h, a),
        "first": lambda g, h, a: cmd_nav("first", g, h, a),
        "last": lambda g, h, a: cmd_nav("last", g, h, a),
        "restack": cmd_restack,
        "submit": cmd_submit,
        "sync": cmd_sync,
        "setup": cmd_setup,
        "__complete": cmd_complete,
    }
    fn = dispatch.get(cmd)
    if fn is None:
        die(f"unknown command: {cmd} (see `stack help`)")
    git = Git()
    if not git.git_ok("rev-parse", "--git-dir"):
        die("not inside a git repo")
    gitcore.apply_display_settings(git, "stack")
    forge = select_forge(git)
    fn(git, forge, rest)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        print()
        sys.exit(130)
