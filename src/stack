# -------- forge selection --------


def select_forge(git):
    """The forge backend for this repo (Gh/Gl), or None when origin is neither
    GitHub nor GitLab. A configured forge overrides the URL sniff for self-hosted
    hosts. Local commands ignore a None forge; submit/sync require one."""
    kind = forge_kind(
        git.origin_url(),
        git.config_chain("stack.forge", f"{gitcore.SHARED_SECTION}.forge"),
    )
    if kind == "github":
        return Gh()
    if kind == "gitlab":
        fullpath = gitlab_fullpath(git.origin_url())
        return Gl(fullpath) if fullpath else None
    return None


def forge_icon_for(forge):
    return ui.SYM_GITLAB if isinstance(forge, Gl) else ui.SYM_GITHUB


def require_forge(forge):
    if forge is None:
        die("no GitHub or GitLab remote detected — set "
            f"`git config {gitcore.SHARED_SECTION}.forge <github|gitlab>` for a self-hosted host")
    forge.require()


