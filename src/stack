def cmd_complete(git, forge, argv):
    gitcore.set_quiet(True)
    what = argv[0] if argv else ""
    if what == "commands":
        print("\n".join(COMMANDS))
    elif what == "stack-branches":
        brs, _dirty = load_state(git)
        for b in sorted(brs):
            print(b)
    elif what == "all-branches":
        for b in git.local_branches():
            print(b)


